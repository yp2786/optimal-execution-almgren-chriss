lambdas = np.logspace(-9, -3, 20)
expected_costs = []
variances = []

for l in lambdas:
    n_opt = opt.solve(risk_aversion=l)
    # Run 1000 Monte Carlo sims to get statistics
    shortfalls = []
    for _ in range(500):
        _, p_exec = opt.simulate_path(n_opt, S0)
        revenue = np.sum(n_opt * p_exec)
        shortfalls.append((S0 * X_total) - revenue)
    
    expected_costs.append(np.mean(shortfalls))
    variances.append(np.var(shortfalls))

plt.scatter(np.sqrt(variances), expected_costs, c=np.log10(lambdas))
plt.title("Efficient Frontier of Optimal Execution")
plt.xlabel("Standard Deviation of Cost (Risk)")
plt.ylabel("Expected Cost (Impact)")
plt.colorbar(label='Log10(Lambda)')
plt.show()
