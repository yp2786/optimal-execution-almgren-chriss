risk_params = [1e-8, 1e-6, 1e-4]
labels = ['Risk Neutral', 'Moderate', 'Risk Averse']

for lambd, lab in zip(risk_params, labels):
    trades = opt.solve(risk_aversion=lambd)
    plt.plot(trades, label=lab)

plt.title("Optimal Trade Trajectories ($n_k$)")
plt.xlabel("Time Step")
plt.ylabel("Shares Sold")
plt.legend()
plt.show()
